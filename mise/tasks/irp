#!/usr/bin/env ruby
#MISE description="Run the W3C SCXML IRP suite against the addon, with the tools/ ECMAScript data model (ADR 0019); --baseline rewrites the expected failures"
# vim:ft=ruby

# The suite in ../tinyactors-test/vendor/scxml-irp is rewritten for the
# ECMAScript data model with tinyactors-test's importer (ConfTransform with
# EcmaExpressions: the W3C's confEcma.xsl, template by template), written to
# build/irp/documents.json, and run on Node and Bun by test/irp/run.js, which
# imports each document with define(xml, { format: 'scxml' }).
#
# test/irp/expected-failures.json names every test known to fail, with the
# reason. A test that fails and is not listed fails this task, and so does a
# listed test that passes, so the list stays true.

require 'json'
require 'fileutils'
require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path
HOST = ROOT.join('../tinyactors-test').expand_path
require HOST.join('ruby/scxml_irp/importer').to_s

suite = HOST.join('vendor/scxml-irp')
importer = SCXML::IRP::Importer.new(suite: suite, scenarios_dir: ROOT.join('build/irp/unused'), root: HOST)

documents = importer.tests.map do |test|
  entry = { id: test.id, label: test.label, conformance: test.conformance }
  reason = test.manual ? 'a manual test (its criterion is the test host\'s)' : importer.send(:skip_reason, test)
  next entry.merge(skip: reason) if reason

  begin
    charts = (test.deps.select { |dep| dep.end_with?('.txml') } + test.starts).map do |uri|
      path = suite.join(uri)
      name = "irp_#{File.basename(uri, '.txml')}"
      resolve = ->(src) { path.dirname.join(src.sub(/\Afile:/, '')).read }
      result = SCXML::IRP::ConfTransform.new(SCXML::IRP::ConfTransform.parse(path), chart_name: name,
                                             top_level: test.starts.include?(uri), resolve_file: resolve,
                                             dialect: SCXML::IRP::EcmaExpressions).convert
      { name: name, source: result.source, files: result.files, start: test.starts.include?(uri) }
    end
    entry.merge(charts: charts)
  rescue SCXML::IRP::Unsupported, REXML::ParseException => e
    entry.merge(skip: e.message.lines.first.strip)
  end
end

out = ROOT.join('build/irp/documents.json')
FileUtils.mkdir_p(out.dirname)
out.write(JSON.pretty_generate(documents))

runner = %w[node bun].map do |runtime|
  [runtime, 'test/irp/run.js', out.to_s, *ARGV]
end
runner = runner.first(1) if ARGV.include?('--baseline')
runner.each do |command|
  puts command.join(' ')
  pid = Process.spawn(*command, chdir: ROOT.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end
