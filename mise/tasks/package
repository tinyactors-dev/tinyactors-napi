#!/usr/bin/env ruby
#MISE description="Stage and pack the npm packages: @tinyactors/node and one platform package per built release target, into build/npm/tarballs/"
#USAGE flag "--targets <targets>" help="Comma-separated release targets to package (default: all four); each must be built with `mise run build --target <t>`"
# vim:ft=ruby

# The npm packages (docs/adr/0001-packaging-and-releases.md):
#
# - @tinyactors/node, staged into build/npm/node/: the files package.json
#   lists, and a package.json without devDependencies and with
#   optionalDependencies on every platform package at exactly its own
#   version. Those live only in the staged copy: the repository's
#   package.json cannot name them, since pnpm cannot lock packages that are
#   not published.
# - @tinyactors/node-<platform>-<arch>, staged into build/npm/node-<p>-<a>/:
#   build/<target>/tinyactors.node as tinyactors.node, with `os` and `cpu`,
#   and no `libc` field: the Linux addon serves glibc and musl.
#
# Every package carries the repository's LICENSE at its root.
#
# package.json's version is the version of every package. A target that is
# not built, or whose addon fails `mise run symbols`, fails the task.

require 'fileutils'
require 'json'
require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path
LICENSE = ROOT.join('../LICENSE').expand_path
NPM = ROOT.join('build/npm')
TARBALLS = NPM.join('tarballs')

# Release target => [npm platform, npm cpu].
PLATFORMS = {
  'aarch64-macos' => %w[darwin arm64],
  'x86_64-macos' => %w[darwin x64],
  'x86_64-linux' => %w[linux x64],
  'aarch64-linux' => %w[linux arm64]
}.freeze

def run(*command, chdir: ROOT)
  pid = Process.spawn(*command, chdir: chdir.to_s)
  _pid, status = Process.wait2(pid)
  abort "package: #{command.join(' ')} failed" unless status.success?
end

requested = ENV['usage_targets'].to_s
requested = ARGV[ARGV.index('--targets') + 1].to_s if requested.empty? && ARGV.include?('--targets')
targets = requested.empty? ? PLATFORMS.keys : requested.split(',').map(&:strip)
unknown = targets - PLATFORMS.keys
abort "package: unknown targets #{unknown.join(', ')}; known: #{PLATFORMS.keys.join(', ')}" unless unknown.empty?

manifest = JSON.parse(ROOT.join('package.json').read)
version = manifest.fetch('version')
missing = targets.reject { |target| ROOT.join("build/#{target}/tinyactors.node").file? }
unless missing.empty?
  abort "package: not built: #{missing.join(', ')}; run `mise run build --target <t>` for each"
end
targets.each { |target| run('mise', 'run', 'symbols', '--target', target) }

abort "package: #{LICENSE} is missing" unless LICENSE.file?
FileUtils.rm_rf(NPM)
FileUtils.mkdir_p(TARBALLS)
shared = manifest.slice('version', 'license', 'homepage', 'repository', 'bugs')

# The main package.
main = NPM.join('node')
manifest.fetch('files').each do |entry|
  source = ROOT.join(entry)
  abort "package: #{entry}, listed in package.json's files, does not exist" unless source.exist?
  FileUtils.mkdir_p(main.join(entry).dirname)
  FileUtils.cp_r(source, main.join(entry))
end
FileUtils.cp(LICENSE, main.join('LICENSE'))
staged = manifest.except('devDependencies')
staged['optionalDependencies'] = PLATFORMS.values.to_h { |platform, cpu| ["@tinyactors/node-#{platform}-#{cpu}", version] }
main.join('package.json').write("#{JSON.pretty_generate(staged)}\n")

# One package per target.
targets.each do |target|
  platform, cpu = PLATFORMS.fetch(target)
  name = "node-#{platform}-#{cpu}"
  dir = NPM.join(name)
  FileUtils.mkdir_p(dir)
  FileUtils.cp(ROOT.join("build/#{target}/tinyactors.node"), dir.join('tinyactors.node'))
  FileUtils.cp(LICENSE, dir.join('LICENSE'))
  package = {
    'name' => "@tinyactors/#{name}",
    'description' => "The #{platform}-#{cpu} native addon of @tinyactors/node",
    **shared,
    'os' => [platform],
    'cpu' => [cpu],
    'main' => 'tinyactors.node',
    'files' => ['tinyactors.node', 'LICENSE']
  }
  dir.join('package.json').write("#{JSON.pretty_generate(package)}\n")
  dir.join('README.md').write(<<~README)
    # @tinyactors/#{name}

    The #{platform}-#{cpu} native addon of
    [@tinyactors/node](https://www.npmjs.com/package/@tinyactors/node).
    Install `@tinyactors/node`, not this package: it depends on the addon for
    each platform, and npm, pnpm and Bun install only the one that matches.
  README
end

(['node'] + targets.map { |target| "node-#{PLATFORMS.fetch(target).join('-')}" }).each do |name|
  run('npm', 'pack', '--silent', '--pack-destination', TARBALLS.to_s, chdir: NPM.join(name))
end
puts "package: #{version}, #{targets.size + 1} packages in #{TARBALLS.relative_path_from(ROOT)}:"
Dir[TARBALLS.join('*.tgz').to_s].sort.each do |tarball|
  puts format('  %8.1f KiB  %s', File.size(tarball) / 1024.0, File.basename(tarball))
end
