#!/usr/bin/env ruby
#MISE description="Check the @tinyactors/node package: every file index.js reaches through require is packed, and no test, tool, build, vendored or doc file is"
# vim:ft=ruby

require 'json'
require 'pathname'
require 'set'

ROOT = Pathname.new(__dir__).join('../..').expand_path

output = IO.popen(%w[npm pack --dry-run --json], chdir: ROOT.to_s, err: File::NULL, &:read)
abort 'tinyactors-napi: npm pack --dry-run failed' unless $?.success?
packed = JSON.parse(output).first.fetch('files').map { |file| file.fetch('path') }.to_set

# Relative requires, followed from the package's entry points the way Node
# resolves them: the path itself, then with .js, then as a directory's index.js.
def resolve(from, request)
  base = from.dirname.join(request)
  [base, Pathname.new("#{base}.js"), base.join('index.js')].find(&:file?) || base
end

manifest = JSON.parse(ROOT.join('package.json').read)
pending = [manifest.fetch('main'), manifest.fetch('types')].map { |entry| ROOT.join(entry) }
reached = Set.new
until pending.empty?
  file = pending.shift
  relative = file.relative_path_from(ROOT).to_s
  next if reached.include?(relative)

  reached << relative
  next unless file.extname == '.js' && file.file?

  file.read.scan(/require\(\s*['"](\.{1,2}\/[^'"]+)['"]\s*\)/).flatten.each do |request|
    pending << resolve(file, request)
  end
end

missing = reached.reject { |path| packed.include?(path) }.sort
# The main package ships JavaScript only: the addon is in the platform
# packages (mise run package), and docs, benches and vendored headers stay in
# the repository.
test_only = packed.select { |path| path.start_with?('tools/', 'test/', 'build/', 'vendor/', 'docs/', 'bench/') }.sort
problems = []
problems << "not packed, but reached from index.js:\n  #{missing.join("\n  ")}" unless missing.empty?
problems << "files that do not belong in the package:\n  #{test_only.join("\n  ")}" unless test_only.empty?
abort "tinyactors-napi: #{problems.join("\n")}" unless problems.empty?

puts "pack-check passed: #{reached.size} files reached from index.js are packed, nothing under tools/, test/, build/, vendor/, docs/ or bench/"
