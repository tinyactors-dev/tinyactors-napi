#!/usr/bin/env ruby
#MISE description="Build the tinyactors Node-API addon: for this machine, or with --target for a release target (zig cc)"
#USAGE flag "--target <target>" help="A release target: aarch64-macos, x86_64-macos, x86_64-linux or aarch64-linux; writes build/<target>/tinyactors.node"
# vim:ft=ruby

require 'fileutils'
require_relative '../lib/compile'

# Every src/**/*.c, compiled together with the core amalgamation (ROADMAP
# step 1). Objects are cached one by one; the host link runs only when an
# object or the link command changed.
#
# Without --target: the addon for this machine, build/tinyactors_napi.node,
# which development and the test suites load. With --target: the addon for
# that release target, built with the pinned zig (mise/lib/toolchain.rb).
target_name = ENV['usage_target'].to_s
target_name = ARGV[ARGV.index('--target') + 1] if target_name.empty? && ARGV.include?('--target')
if target_name.nil? || target_name.empty?
  NapiCompile.link(NapiCompile.addon_objects, NapiCompile::BUILD.join('tinyactors_napi.node'),
                   flags: NapiCompile.addon_link_flags)
else
  target = Toolchain.target(target_name)
  abort "tinyactors-napi: #{target.name} has no Node-API addon" if target.wasm?
  NapiCompile.link_target(target)
end
