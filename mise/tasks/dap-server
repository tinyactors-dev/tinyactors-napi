#!/usr/bin/env ruby
#MISE description="Serve a debug session over an example system, for trying DAP clients (napi ADR 0026)"
# vim:ft=ruby
#USAGE flag "--port <port>" help="Serve sessions on 127.0.0.1:<port> instead of stdin and stdout"
#USAGE flag "--watch" help="Grant no permission: sessions only watch"
#
# `mise run dap-server -- --port 4711`, then point a client at the port
# (VS Code: "debugServer": 4711) and attach with
# { "address": "subscription/acct_1" }. Without --port it
# speaks DAP on stdin and stdout, as a client that starts adapters expects.
# tools/dap-server.js says what the example runs.

require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path

def run(*command, **options)
  pid = Process.spawn(*command, chdir: ROOT.to_s, **options)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

forward = []
forward.push('--port', ENV['usage_port']) if ENV['usage_port'] && !ENV['usage_port'].empty?
forward.push('--watch') if ENV['usage_watch'] == 'true'
# The build writes to stdout, which carries DAP: it goes to stderr.
run('mise', 'run', 'build', out: $stderr)
run('node', 'tools/dap-server.js', *forward)
