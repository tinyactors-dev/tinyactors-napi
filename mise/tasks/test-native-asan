#!/usr/bin/env ruby
#MISE description="Run the addon's native C unit tests under AddressSanitizer and UBSan"
# vim:ft=ruby

require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path

# Same tests as test-native, compiled with TNA_SANITIZE=1 into build/obj-asan.
pid = Process.spawn({ 'TNA_SANITIZE' => '1' }, 'mise', 'run', 'test-native', chdir: ROOT.to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?
