#!/usr/bin/env ruby
#MISE description="Check the release addons' symbols: Node-API 10 and an allowlist of libc functions, no needed libraries on Linux, the right architecture"
#USAGE flag "--target <target>" help="Check one release target (default: every target built under build/<target>/)"
# vim:ft=ruby

# What an addon may import (docs/adr/0001-packaging-and-releases.md,
# docs/proposals/packaging.md "One Linux addon for glibc and musl"):
#
# - Node-API functions of version 10 or older, as the vendored
#   node-api-headers' symbols.js lists them; the process that loads the
#   addon provides them.
# - On Linux, the libc functions in LINUX_LIBC and nothing else, and no
#   DT_NEEDED entry at all: the addon links no C library, so it binds to the
#   libc Node itself runs on. Each function here is checked to have the same
#   name, arguments and types in glibc and musl; a new one fails the check
#   until it has been.
# - On macOS, the same functions from libSystem, plus DARWIN_EXTRA.
#
# It may export only the two Node-API registration functions. Mach-O files
# need llvm's tools; ELF files are read with llvm's or binutils'.

require 'json'
require 'open3'
require 'pathname'
require 'set'
require 'toolchain'

ROOT = Pathname.new(__dir__).join('../..').expand_path
BUILD = ROOT.join('build')

LINUX_LIBC = %w[
  aligned_alloc bcmp calloc clock_gettime floor free getrandom malloc memchr memcpy memmove memset
  realloc snprintf strlen strtod timespec_get
].freeze

# libSystem symbols a macOS addon may import beyond LINUX_LIBC, each for a
# reason that holds on every macOS the addon supports.
DARWIN_EXTRA = {
  'arc4random_buf' => "src/system.c seeds trace IDs with it where Linux uses getrandom",
  'bzero' => 'clang lowers zeroing to it on Darwin (arm64)',
  '__bzero' => 'clang lowers zeroing to it on Darwin (x86_64)',
  'memcmp' => 'Darwin lowers bcmp to memcmp',
  '__memcpy_chk' => "the SDK headers turn on _FORTIFY_SOURCE; libSystem has provided it since 10.5",
  'dyld_stub_binder' => "the linker's lazy-binding helper, in every dylib with stubs"
}.freeze
DARWIN_LIBC = (LINUX_LIBC - %w[getrandom] + DARWIN_EXTRA.keys).freeze

EXPORTS = %w[napi_register_module_v1 node_api_module_get_api_version_v1].freeze
# Symbols the Mach-O linker defines in every dylib.
DARWIN_LINKER_EXPORTS = %w[__dso_handle _mh_dylib_header].freeze

ARCH = {
  'x86_64-linux' => /ELF 64-bit LSB shared object, x86-64/,
  'aarch64-linux' => /ELF 64-bit LSB shared object, ARM aarch64/,
  'x86_64-macos' => /Mach-O 64-bit x86_64 dynamically linked shared library/,
  'aarch64-macos' => /Mach-O 64-bit arm64 dynamically linked shared library/
}.freeze

def capture(*command)
  out, status = Open3.capture2e(*command)
  abort "symbols: #{command.join(' ')} failed:\n#{out}" unless status.success?
  out
end

def tool(*names)
  names.find { |name| system('which', name, out: File::NULL, err: File::NULL) }
end

NM = tool('llvm-nm', 'nm') || abort('symbols: needs llvm-nm or nm')
READELF = tool('llvm-readelf', 'readelf') || abort('symbols: needs llvm-readelf or readelf')
OTOOL = tool('llvm-otool')

node_api = JSON.parse(capture('node', '-e', <<~JS))
  const { v10 } = require(#{ROOT.join('vendor/node-api-headers/symbols.js').to_s.to_json});
  console.log(JSON.stringify([...v10.js_native_api_symbols, ...v10.node_api_symbols]));
JS
NODE_API = node_api.to_set.freeze

# Names from `nm` output lines, without Mach-O's leading underscore.
def names(output, macos)
  output.lines.map { |line| line.split.last }.compact.map { |name| macos ? name.delete_prefix('_') : name }.sort
end

def check(target)
  addon = BUILD.join(target.name, 'tinyactors.node')
  return ["#{addon.relative_path_from(ROOT)} is not built: mise run build --target #{target.name}"] unless addon.file?

  problems = []
  described = capture('file', '-b', addon.to_s)
  problems << "architecture: #{described.strip}" unless ARCH.fetch(target.name).match?(described)

  if target.macos?
    abort 'symbols: a macOS addon needs llvm-nm and llvm-otool' unless NM.start_with?('llvm') && OTOOL
    libraries = capture(OTOOL, '-L', addon.to_s).lines.drop(1).map { |line| line.strip.split.first }
    extra = libraries - ['@rpath/tinyactors.node', '/usr/lib/libSystem.B.dylib']
    problems << "links libraries beyond libSystem: #{extra.join(', ')}" unless extra.empty?
    allowed_libc = DARWIN_LIBC
  else
    needed = capture(READELF, '-d', addon.to_s).lines.grep(/NEEDED/)
    problems << "needs libraries (it must link no C library):\n    #{needed.map(&:strip).join("\n    ")}" unless needed.empty?
    allowed_libc = LINUX_LIBC
  end

  imported = names(capture(NM, *(target.macos? ? [] : ['-D']), '--undefined-only', addon.to_s), target.macos?)
  newer = imported.select { |name| name.start_with?('napi_', 'node_api_') && !NODE_API.include?(name) }
  problems << "Node-API functions newer than version 10: #{newer.join(', ')}" unless newer.empty?
  unknown = imported.reject { |name| name.start_with?('napi_', 'node_api_') || allowed_libc.include?(name) }
  unless unknown.empty?
    problems << "imports functions not on the allowlist: #{unknown.join(', ')}. Check that each has the same " \
                'name, arguments and types in glibc and musl (and exists in libSystem) before adding it to ' \
                'mise/tasks/symbols.'
  end

  exported = names(capture(NM, *(target.macos? ? [] : ['-D']), '--defined-only', '--extern-only', addon.to_s),
                   target.macos?)
  exported -= DARWIN_LINKER_EXPORTS if target.macos?
  problems << "exports #{exported.join(', ')}; only #{EXPORTS.join(' and ')} may be" unless exported == EXPORTS
  libc = imported.count { |name| allowed_libc.include?(name) }
  puts "#{target.name}: #{imported.size - libc} Node-API and #{libc} libc imports, exports #{EXPORTS.join(', ')}" if problems.empty?
  problems
end

names_given = ENV['usage_target'].to_s
names_given = ARGV[ARGV.index('--target') + 1].to_s if names_given.empty? && ARGV.include?('--target')
targets = if names_given.empty?
            Toolchain::TARGETS.values.reject(&:wasm?).select { |target| BUILD.join(target.name, 'tinyactors.node').file? }
          else
            [Toolchain.target(names_given)]
          end
abort 'symbols: no release addon is built; run mise run build --target <target>' if targets.empty?

puts "symbols: read with #{[NM, READELF, OTOOL].compact.uniq.join(', ')}"
failures = targets.to_h { |target| [target.name, check(target)] }.reject { |_, problems| problems.empty? }
failures.each do |name, problems|
  warn "#{name}:"
  problems.each { |problem| warn "  #{problem}" }
end
exit(failures.empty? ? 0 : 1)
