#!/usr/bin/env ruby
#MISE description="Regenerate src/gen/ta_napi.{c,h} from tinyactors.api.json and bindings.rb (ADR 0013)"
# vim:ft=ruby
#USAGE flag "--check" help="Regenerate into a temporary directory and fail if src/gen differs"
#USAGE flag "--report" help="Print every function and type with its category"

require 'digest'
require 'fileutils'
require 'pathname'
require 'tmpdir'
require_relative '../lib/napi/emit'

ROOT = Pathname.new(__dir__).join('../..').expand_path
GEN = ROOT.join('src/gen')
check = ENV['usage_check'] == 'true' || ARGV.include?('--check')
report = ENV['usage_report'] == 'true' || ARGV.include?('--report')

begin
  plan = NapiGen::Plan.new(NapiGen::API.load, NapiGen::Policy.load(ROOT.join('bindings.rb')))
rescue NapiGen::Error => e
  abort "tinyactors-napi bindings: #{e.message}"
end
inputs = {
  'tinyactors-core/include/tinyactors.api.json' => Digest::SHA256.file(NapiGen::API::DESCRIPTION).hexdigest,
  'tinyactors-napi/bindings.rb' => Digest::SHA256.file(ROOT.join('bindings.rb')).hexdigest
}
emit = NapiGen::Emit.new(plan, inputs)
files = { 'ta_napi.h' => emit.header, 'ta_napi.c' => emit.source }

if report
  plan.report.sort.each do |category, items|
    puts "#{category} (#{items.size})"
    items.each { |item| puts(item.is_a?(Array) ? "  #{item[0]}: #{item[1].is_a?(Hash) ? item[1][:reason] : item[1]}" : "  #{item}") }
  end
end

if check
  Dir.mktmpdir('tinyactors-napi-bindings') do |dir|
    stale = files.reject do |name, content|
      path = GEN.join(name)
      File.write(File.join(dir, name), content)
      path.file? && path.read == content
    end
    unless stale.empty?
      abort "tinyactors-napi: src/gen/#{stale.keys.join(' and src/gen/')} #{stale.size == 1 ? 'is' : 'are'} stale; " \
            'run `mise run bindings` ' \
            'and commit the result (ADR 0013)'
    end
  end
  puts 'tinyactors-napi: src/gen is up to date'
else
  FileUtils.mkdir_p(GEN)
  files.each do |name, content|
    path = GEN.join(name)
    next if path.file? && path.read == content

    File.write(path, content)
    puts "wrote #{path.relative_path_from(ROOT)}"
  end
  counts = Hash.new(0).merge(plan.report.transform_values(&:size))
  puts "functions: #{counts[:functions_bound]} bound, #{counts[:functions_hooked]} hooked, " \
       "#{counts[:functions_plumbing]} plumbing-owned, #{counts[:functions_overridden]} overridden, " \
       "#{counts[:functions_skipped]} skipped"
end
