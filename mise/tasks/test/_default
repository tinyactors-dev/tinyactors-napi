#!/usr/bin/env ruby
#MISE description="Build and test the tinyactors Node-API addon: binding staleness, native unit tests, the package contents, then the JS suites on Node.js and Bun (the scale test on Bun and at a million actors only with --full)"
#MISE sources=["bindings.rb", "index.d.ts", "index.js", "package.json", "pnpm-lock.yaml", "lib/**/*", "src/**/*", "test/**/*", "tools/**/*", "mise/**/*", "mise.toml", "../tinyactors-core/include/**/*", "../tinyactors-core/src/**/*", "../tinyxml/include/**/*", "../tinyactors-scxml/include/**/*", "../tinyactors-scxml/src/**/*", "../tinyactors-test/dap/**/*", "../tinyactors-test/ruby/scxml_irp/**/*", "../tinyactors-test/vendor/scxml-irp/**/*", "../mise/lib/**/*", "../mise.toml"]
#MISE outputs={auto=true}
#USAGE flag "--full" help="Also run the scale test on Bun and up to a million actors"
# vim:ft=ruby

require 'etc'
require 'pathname'
require 'tempfile'

ROOT = Pathname.new(__dir__).join('../../..').expand_path
full = ENV['usage_full'] == 'true' || ARGV.include?('--full')

def run(*command)
  puts command.reject { |part| part.is_a?(Hash) }.join(' ')
  pid = Process.spawn(*command, chdir: ROOT.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

# Runs independent commands at once, one per CPU, and prints each one's
# output in the order given once it has finished; fails when any failed.
def run_all(commands)
  queue = Queue.new
  commands.each_with_index { |command, index| queue << [command, index] }
  queue.close
  outputs = Array.new(commands.size)
  workers = Array.new([Etc.nprocessors, commands.size].min) do
    Thread.new do
      while (item = queue.pop)
        command, index = item
        Tempfile.create('suite') do |log|
          pid = Process.spawn(*command, chdir: ROOT.to_s, out: log, err: log)
          _pid, status = Process.wait2(pid)
          outputs[index] = [command.join(' '), status.success?, File.read(log.path)]
        end
      end
    end
  end
  workers.each(&:join)
  outputs.each do |name, _, text|
    puts name
    print text
  end
  failed = outputs.reject { |_, ok, _| ok }.map(&:first)
  abort "failed: #{failed.join(', ')}" unless failed.empty?
end

run('mise', 'run', 'bindings', '--check')
run('mise', 'run', 'build')
run('mise', 'run', 'test-native')
run('mise', 'run', 'test-native-asan')
run('mise', 'run', 'pack-check')
# index.d.ts is the desired API: its status markers must match lib/.
run('mise', 'run', 'check-api-status')
# The W3C IRP suite against the addon, with the tools/ ECMAScript data model
# (ADR 0019); known failures are listed in test/irp/expected-failures.json.
run('mise', 'run', 'irp')

# The scale test compares costs across populations, so it runs alone. The
# fast pass runs it on Node at 50,000 and 200,000 actors; --full runs it on
# Bun too, and up to a million actors where memory allows.
scale = full ? { 'TAT_SCALE_MAX_POPULATION' => '1000000' } : {}
(full ? %w[node bun] : %w[node]).each { |engine| run(scale, engine, 'test/scale.js') }

suites = Dir[ROOT.join('test/*.js').to_s].sort.map { |suite| Pathname.new(suite).relative_path_from(ROOT).to_s }
run_all((suites - ['test/scale.js']).flat_map { |suite| [['node', suite], ['bun', suite]] })
