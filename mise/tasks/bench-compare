#!/usr/bin/env ruby
#MISE description="Build a commit beside the working tree and run both benches alternately on this machine: throughput and memory, with changes outside 5% flagged"
# vim:ft=ruby

# Usage: mise run bench-compare <commit> [population ...] [--variants=a,b]
#          [--runtimes=node,bun] [--runs=2] [--store]
#
# Absolute figures move between days on one machine (the same build ran at
# 622 and then 443 ns per event), so builds are compared side by side: the
# old commit is built in a temporary git worktree, then old and new run
# alternately (--runs times each, default 2), with today's bench script
# against both packages. For each variant it prints the old and new medians
# of throughput and memory and the change, and flags a change past 5% in
# the worse direction. --store also appends every run's records to
# bench/results/<machine signature>/ (bench/results/README.md). The
# worktree is removed afterwards, even on failure.

require 'open3'
require 'tmpdir'
require_relative '../lib/napi/bench'

base = ARGV.find { |arg| !arg.start_with?('--') }
abort 'usage: mise run bench-compare <commit> [population ...] [--variants=a,b] [--runs=2] [--store]' if base.nil?
options = NapiBench.parse(ARGV - [base])
runs = (ARGV.find { |arg| arg.start_with?('--runs=') }&.delete_prefix('--runs=') || '2').to_i
store = ARGV.include?('--store')
root = NapiBench::ROOT
repo = NapiBench.git('rev-parse', '--show-toplevel')
old_commit = NapiBench.git('rev-parse', '--short=7', base) or abort "tinyactors-napi: unknown commit #{base}"
new_commit = NapiBench.commit
dirty = NapiBench.dirty?

def step(command, dir, what)
  output, status = Open3.capture2e(*command, chdir: dir)
  abort "tinyactors-napi: #{what} failed in #{dir}:\n#{output.lines.last(30).join}" unless status.success?
end

# Throughput and memory figures compared, and which direction is worse.
METRICS = [
  ['ns/event', %w[throughput nsPerEvent], :higher],
  ['core B/actor', %w[memory coreBytesPerActor], :higher],
  ['native B/actor', %w[memory nativeBytesPerActor total], :higher],
  ['RSS B/actor', %w[memory rssBytesPerActor], :higher],
  ['heap B/actor', %w[memory heapBytesPerActor], :higher],
  ['alloc/event', %w[memory allocatorCallsPerEvent], :higher],
  ['OTLP B/event', %w[memory otlpBytesPerEvent], :higher]
].freeze

def median(values)
  sorted = values.compact.sort
  return nil if sorted.empty?

  sorted[sorted.length / 2]
end

Dir.mktmpdir('tinyactors-bench-compare') do |tmp|
  worktree = File.join(tmp, 'base')
  begin
    step(['git', 'worktree', 'add', '--detach', worktree, old_commit], repo, 'git worktree add')
    # A fresh checkout's mise configs are untrusted; trust them for this run
    # only (the ensure below untrusts them).
    trusted = Dir.glob(File.join(worktree, '{,*/}mise.toml'))
    trusted.each { |config| step(['mise', 'trust', '--quiet', config], worktree, 'mise trust') }
    old_root = File.join(worktree, 'tinyactors-napi')
    step(%w[pnpm install --frozen-lockfile], old_root, 'pnpm install')
    step(%w[mise run build], old_root, "building #{old_commit}")
    step(%w[mise run build], root, "building #{new_commit}")

    options[:runtimes].each do |runtime|
      signature = NapiMachine.signature(runtime, root)
      options[:populations].each do |population|
        collected = { old: [], new: [] }
        runs.times do
          { old: [old_root, old_commit, false], new: [root, new_commit, dirty] }.each do |side, (dir, commit, side_dirty)|
            before = NapiMachine.conditions
            result = NapiBench.run(dir: dir, runtime: runtime, population: population, variants: options[:variants])
            after = NapiMachine.conditions
            records = NapiBench.records(result, signature: signature, commit: commit, dirty: side_dirty,
                                                before: before, after: after)
            NapiBench.store(records, signature) if store
            collected[side].concat(records)
          end
        end

        puts "#{runtime}, #{population} actors, #{old_commit} → #{new_commit}#{dirty ? ' (dirty)' : ''}, " \
             "machine #{signature['hash']}, #{runs} alternating runs each, medians"
        variants = collected[:new].map { |record| record['variant'] }.uniq
        flagged = 0
        variants.each do |variant|
          old_runs = collected[:old].select { |record| record['variant'] == variant && !record['error'] }
          new_runs = collected[:new].select { |record| record['variant'] == variant && !record['error'] }
          if old_runs.empty? || new_runs.empty?
            puts "  #{variant}: #{old_runs.empty? ? old_commit : new_commit} could not run it"
            next
          end
          puts "  #{variant}"
          METRICS.each do |label, path, worse|
            old_value = median(old_runs.map { |record| record.dig(*path) })
            new_value = median(new_runs.map { |record| record.dig(*path) })
            next if old_value.nil? && new_value.nil?

            change = old_value.nil? || new_value.nil? || old_value.zero? ? nil : (new_value - old_value) / old_value * 100
            flag = !change.nil? && (worse == :higher ? change > 5 : change < -5)
            flagged += 1 if flag
            digits = label == 'alloc/event' ? 2 : 0
            puts format('    %-16s %12s %12s %9s%s', label, NapiBench.num(old_value, digits), NapiBench.num(new_value, digits),
                        change.nil? ? '-' : format('%+.1f%%', change), flag ? '  ← worse than 5%' : '')
          end
        end
        puts "  #{flagged.zero? ? 'nothing' : flagged} outside the 5% rule"
        puts
      end
    end
  ensure
    (trusted || []).each { |config| system('mise', 'trust', '--untrust', '--quiet', config, out: File::NULL, err: File::NULL) }
    system('git', 'worktree', 'remove', '--force', worktree, chdir: repo, out: File::NULL, err: File::NULL)
    system('git', 'worktree', 'prune', chdir: repo, out: File::NULL, err: File::NULL)
  end
end
