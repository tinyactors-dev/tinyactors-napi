#!/usr/bin/env ruby
#MISE description="Build and run the addon's native C unit tests (test/native/*_test.c)"
# vim:ft=ruby

require 'fileutils'
require_relative '../lib/compile'

# Each test/native/<name>_test.c becomes one executable, linked with the addon
# objects that do not use Node-API and the core amalgamation. An object whose
# translation unit included node_api.h cannot link without a Node process, so
# it is left out; a native test exercises only plumbing that does not need it.
# Only the sources in NapiCompile::NODE_API_SOURCES may include node_api.h;
# any other source that does fails this task instead of losing its tests.
root = NapiCompile::ROOT
plumbing, _node_api = NapiCompile.partition_node_api(NapiCompile.sources)
shared = plumbing + [NapiCompile.core_object] + NapiCompile.codec_objects

tests = Cache.files('test/native/*_test.c')
abort 'tinyactors-napi: no native tests found' if tests.empty?

tests.each do |test|
  object = NapiCompile.objects([test]).first
  binary = NapiCompile::NATIVE.join(test.basename('.c'))
  NapiCompile.link([object, *shared], binary)
  puts binary.relative_path_from(root)
  pid = Process.spawn(binary.to_s, chdir: root.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end
