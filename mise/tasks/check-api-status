#!/usr/bin/env ruby
#MISE description="Check index.d.ts's status markers against the runtime: what is marked unimplemented must be missing, and what is not marked must exist"
# vim:ft=ruby
#
# index.d.ts is the desired public API (see its header). A declaration lib/
# does not implement carries `// status: unimplemented`, or
# `// status: partial: <what is missing>`, on the line directly above it.
#
# This task checks both directions where the runtime can answer: the
# package's exports, and the members of the objects a probe can reach
# (System, Actor, Definition, SessionImage, PreparedActor, the builders,
# TinyactorsError; mise/lib/api_status_probe.js), and the required fields
# of the records it returns (an actor's and a definition's inspection, a
# delayed send's, stats() and metrics()). For each:
# - marked unimplemented but present: fail, the marker is stale;
# - not marked unimplemented but missing: fail, mark it or implement it.
# Declarations of plain data (options, records, specs) cannot be probed;
# their markers are only checked for form. --report lists every finding
# without failing.

require 'json'
require 'pathname'
require 'tempfile'

ROOT = Pathname.new(__dir__).join('../..').expand_path
DTS = ROOT.join('index.d.ts')
MARKER = %r{\A\s*// status: (unimplemented|partial)(?:: (.+))?\z}
report = ARGV.include?('--report')

lines = DTS.readlines(chomp: true)
problems = []
marker_of = lambda do |index|
  previous = index.positive? ? lines[index - 1] : ''
  match = MARKER.match(previous)
  match && match[1]
end

lines.each_with_index do |line, index|
  next unless line =~ %r{\A\s*// status:}
  next if MARKER.match?(line) && !(line =~ /partial\z/)

  problems << "index.d.ts:#{index + 1}: malformed marker; write `// status: unimplemented` or `// status: partial: <what is missing>`"
end

exports = {}
members = Hash.new { |hash, key| hash[key] = {} }
current = nil
lines.each_with_index do |line, index|
  if (match = line.match(/\Aexport (?:declare )?(?:const|function|class) ([A-Za-z_$][\w$]*)/))
    exports[match[1]] = { line: index + 1, status: marker_of.call(index) }
  end
  if (match = line.match(/\Aexport interface ([A-Za-z_$][\w$]*)/))
    current = match[1]
    next
  end
  current = nil if line == '}'
  next if current.nil?

  match = line.match(/\A  (?:readonly )?([A-Za-z_$][\w$]*)(\?)?\s*[(<:]/)
  next unless match

  entry = members[current][match[1]] ||= { line: index + 1, status: nil, optional: !match[2].nil? }
  entry[:status] ||= marker_of.call(index)
end

request = { exports: exports.keys, members: members.transform_values(&:keys) }
answer = Tempfile.create(['api-status', '.json']) do |file|
  file.write(JSON.generate(request))
  file.flush
  output = IO.popen(['node', ROOT.join('mise/lib/api_status_probe.js').to_s, file.path], chdir: ROOT.to_s, &:read)
  abort "check-api-status: the probe failed" unless $?.success?
  JSON.parse(output)
end

judge = lambda do |label, entry, present|
  if entry[:status] == 'unimplemented' && present
    problems << "index.d.ts:#{entry[:line]}: #{label} is marked unimplemented but exists; remove the marker"
  elsif entry[:status] != 'unimplemented' && !present
    problems << "index.d.ts:#{entry[:line]}: #{label} is declared but missing from lib/; implement it or mark it `// status: unimplemented`"
  end
end

exports.each { |name, entry| judge.call("export #{name}", entry, answer['exports'][name]) }
probed = 0
members.each do |kind, names|
  found = answer['members'][kind]
  next if found.nil?

  probed += 1
  record = found['__record']
  names.each do |name, entry|
    # A record's optional field may be absent at runtime without meaning anything.
    next if record && entry[:optional] && entry[:status] != 'unimplemented'

    judge.call("#{kind}.#{name}", entry, found[name])
  end
end

if problems.empty?
  puts "check-api-status: #{exports.size} exports and #{probed} interfaces agree with their markers"
else
  puts problems
  exit(report ? 0 : 1)
end
