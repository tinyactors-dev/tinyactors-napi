#!/usr/bin/env ruby
#MISE description="Send one traced request through three actors to an OTLP/HTTP collector such as otel-tui (ADR 0015)"
# vim:ft=ruby
#
# Start otel-tui first, in another terminal:
#
#   mise exec aqua:ymtdzzz/otel-tui -- otel-tui
#
# then run `mise run otel-demo`. The trace shows up under "POST /orders".
# OTEL_EXPORTER_OTLP_ENDPOINT picks another collector (default
# http://localhost:4318, otel-tui's OTLP/HTTP port).

require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path

def run(*command)
  pid = Process.spawn(*command, chdir: ROOT.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

run('mise', 'run', 'build')
run('node', 'tools/otel-demo.js')
