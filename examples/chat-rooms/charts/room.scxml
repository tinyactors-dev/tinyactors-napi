<?xml version="1.0" encoding="UTF-8"?>
<!-- A room: its members and what was said.

     When it starts it saves itself (chat:db, room.save) and announces
     itself to its workspace (room.started), whoever spawned it: the
     workspace's Spawner, or the application rebuilding the rooms from the
     database after a restart.

     Its members are connections, keyed by the fragment of their address
     (sender(_event.origin), room.js: one key whichever form the origin
     of their join has). A post from a member goes into the history, into the
     database (chat:db, message.insert) and to every member's socket in
     one send to the gateway (chat:gateway, broadcast); the gateway answers
     members.gone with the members whose socket has gone away.

     A room never ends, and hibernates when idle: a send to its name
     (tinyactors://chat/@room.<workspace>.<name>) wakes it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="room" initial="open">
  <script src="room.js"/>
  <datamodel>
    <data id="workspace"/>                <!-- given at spawn -->
    <data id="name"/>                     <!-- given at spawn -->
    <data id="history" expr="[]"/>        <!-- the last messages; given at a restart -->
    <data id="members" expr="({})"/>      <!-- #_scxml_<connection> -> user -->
  </datamodel>
  <state id="open">
    <onentry>
      <send type="chat:db" event="room.save">
        <content expr="{ workspace: workspace, name: name }"/>
      </send>
      <send targetexpr="workspaceAddress(workspace)" event="room.started">
        <content expr="{ name: name }"/>
      </send>
    </onentry>

    <transition event="join">
      <assign location="members" expr="withEntry(members, sender(_event.origin), _event.data.user)"/>
      <send targetexpr="_event.origin" event="room.joined">
        <content expr="{ room: name, history: recent(history) }"/>
      </send>
    </transition>
    <transition event="leave">
      <assign location="members" expr="withoutEntry(members, sender(_event.origin))"/>
    </transition>
    <transition event="post" cond="sender(_event.origin) in members">
      <assign location="history" expr="remember(history, message(name, members, _event))"/>
      <send type="chat:db" event="message.insert">
        <content expr="stored(workspace, name, members, _event)"/>
      </send>
      <send type="chat:gateway" event="broadcast">
        <content expr="{ to: Object.keys(members), event: 'room.message', data: message(name, members, _event) }"/>
      </send>
    </transition>
    <transition event="members.gone">      <!-- the gateway found no socket for them -->
      <assign location="members" expr="withoutAll(members, _event.data.members)"/>
    </transition>
    <transition event="kick">              <!-- an admin's ask: the reply goes to _event.origin -->
      <assign location="members" expr="withoutUser(members, _event.data.user)"/>
      <send targetexpr="_event.origin" event="kicked">
        <content expr="{ members: users(members) }"/>
      </send>
    </transition>
  </state>
</scxml>
